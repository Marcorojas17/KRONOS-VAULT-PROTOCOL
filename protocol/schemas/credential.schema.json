{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Marcorojas17/kronos-protocol/protocol/schemas/credential.schema.json",
  "title": "KTP Credential",
  "description": "Validates a KTP-001 credential.",
  "ktp_version": "0.1.0",
  "license": "CC-BY-4.0",
  "sha256": "",
  "type": "object",
  "additionalProperties": false,
  "required": ["folio", "version", "issued", "issuer", "hashes", "timestamps", "state"],
  "properties": {
    "folio": { "$ref": "folio.schema.json" },
    "version": { "type": "string", "const": "KTP-001/v0.1.0" },
    "issued": { "type": "string", "format": "date-time" },
    "issuer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "string", "minLength": 3 },
        "name": { "type": "string", "minLength": 1 }
      }
    },
    "hashes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256"],
      "properties": {
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "sha512": { "type": "string", "pattern": "^[a-f0-9]{128}$" }
      }
    },
    "timestamps": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "authority", "timestamp"],
        "properties": {
          "type": { "type": "string", "const": "rfc3161" },
          "authority": { "type": "string", "minLength": 1 },
          "timestamp": { "type": "string", "format": "date-time" },
          "url": { "type": "string", "format": "uri" }
        }
      }
    },
    "anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["chain", "tx"],
      "properties": {
        "chain": { "type": "string", "enum": ["ethereum", "polygon", "opentimestamps"] },
        "tx": { "type": "string", "minLength": 10 },
        "timestamp": { "type": "string", "format": "date-time" }
      }
    },
    "state": { "type": "integer", "enum": [0, 1] },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "alg": { "type": "string", "enum": ["EdDSA", "ES256"] },
        "kid": { "type": "string" },
        "value": { "type": "string" }
      }
    }
  }
}
